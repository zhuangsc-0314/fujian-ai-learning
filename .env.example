# 复制到 .env 后填写你自己的 API Key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com

# 后续政策问答的百炼 Embedding 配置；阶段0.1无需填写。
# API Key由你填写；接口地址按业务空间和地域控制台填写，不填占位URL。
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_BASE=
EMBEDDING_DIMENSIONS=1024
